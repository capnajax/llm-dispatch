{
  "name": "llm-proxy",
  "version": "0.1.0",
  "description": "Minimal OpenAI-compatible LLM proxy (pass-through to llama backend)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:www": "vite --config www/vite.config.ts",
    "build": "npm run generate && npm run build:www && tsc && cp src/prompts/prompts.yaml dist/prompts",
    "build:www": "vite build --config www/vite.config.ts",
    "test:www": "vitest run --config www/vite.config.ts",
    "generate": "src/types/generator/generate.sh",
    "generate-ec": "src/types/generator/generate.sh --do-error-codes",
    "start": "npm run build && node dist/index.js",
    "start-nogen": "tsc && node dist/index.js"
  },
  "dependencies": {
    "@filamentjs/request-logging": "^0.1.0",
    "args-and-envs": "^0.6.3",
    "filamentjs": "^0.6.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rocket-shell": "^2.1.0",
    "source-map-support": "^0.5.21",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/source-map-support": "^0.5.10",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "ts-morph": "^28.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
