{
  "name": "llm-proxy",
  "version": "0.1.0",
  "description": "Minimal OpenAI-compatible LLM proxy (pass-through to llama backend)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run generate && tsc && cp src/prompts/prompts.yaml dist/prompts",
    "generate": "src/types/generator/generate.sh",
    "generate-ec": "src/types/generator/generate.sh --do-error-codes",
    "start": "npm run build && node dist/index.js",
    "start-nogen": "tsc && node dist/index.js"
  },
  "dependencies": {
    "args-and-envs": "^0.6.3",
    "filamentjs": "^0.5.0",
    "rocket-shell": "^2.1.0",
    "source-map-support": "^0.5.21",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/node": "^20.0.0",
    "@types/source-map-support": "^0.5.10",
    "ts-morph": "^28.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
